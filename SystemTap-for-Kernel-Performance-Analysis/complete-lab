Task 3: System Call Analysis and I/O Bottleneck Detection
Step 3.1: Comprehensive System Call Tracer
cat > syscall_tracer.stp << 'EOF'
#!/usr/bin/env stap

global syscall_count, syscall_time, syscall_errors
global process_syscalls, start_times

probe syscall.* {
    if (target() == 0 || target() == pid()) {
        syscall_count[name]++
        process_syscalls[execname(), name]++
        start_times[tid(), name] = gettimeofday_us()
    }
}

probe syscall.*.return {
    if (target() == 0 || target() == pid()) {
        start_time = start_times[tid(), name]
        if (start_time) {
            duration = gettimeofday_us() - start_time
            syscall_time[name] += duration
            delete start_times[tid(), name]

            if ($return < 0) {
                syscall_errors[name]++
                printf("ERROR: %s in %s (pid=%d) returned %d\n",
                       name, execname(), pid(), $return)
            }

            if (duration > 10000) {
                printf("SLOW SYSCALL: %s in %s took %d us\n",
                       name, execname(), duration)
            }
        }
    }
}

probe timer.s(20) {
    printf("\n=== System Call Statistics ===\n")
    printf("%-20s %10s %15s %10s %15s\n",
           "SYSCALL", "COUNT", "TOTAL_TIME_US", "ERRORS", "AVG_TIME_US")

    foreach (syscall in syscall_count- limit 20) {
        avg_time = (syscall_count[syscall] > 0) ?
                   syscall_time[syscall] / syscall_count[syscall] : 0
        printf("%-20s %10d %15d %10d %15d\n",
               syscall, syscall_count[syscall], syscall_time[syscall],
               syscall_errors[syscall], avg_time)
    }

    printf("\n=== Top Processes by System Call Activity ===\n")
    foreach ([proc, syscall] in process_syscalls- limit 15) {
        printf("%s: %s (%d calls)\n", proc, syscall, process_syscalls[proc, syscall])
    }

    delete syscall_count
    delete syscall_time
    delete syscall_errors
    delete process_syscalls
}

probe end {
    printf("\nSystem call tracing completed\n")
}
EOF

chmod +x syscall_tracer.stp
Step 3.2: I/O Load Generator and Bottleneck Detector
Create a load generator to produce measurable I/O pressure:

cat > generate_io_load.sh << 'EOF'
#!/bin/bash

echo "Generating I/O load for testing..."

for i in {1..5}; do
    (
        echo "Starting I/O worker $i"
        dd if=/dev/urandom of=/tmp/iotest_$i bs=1M count=50 2>/dev/null

        for j in {1..100}; do
            dd if=/tmp/iotest_$i of=/dev/null bs=4k skip=$((RANDOM % 1000)) count=1 2>/dev/null
            sleep 0.1
        done

        rm -f /tmp/iotest_$i
    ) &
done

find /usr -type f -name "*.so" | head -50 | xargs -I {} cp {} /tmp/ 2>/dev/null

wait

echo "I/O load generation completed"
EOF

chmod +x generate_io_load.sh
Create the bottleneck detector, which watches file-level read/write sizes and system call latency instead of relying on kernel tracepoints that vary between kernel builds:

cat > io_bottleneck_detector.stp << 'EOF'
#!/usr/bin/env stap

global slow_syscalls, large_reads, large_writes
global process_io_bytes, start_times

probe syscall.read, syscall.write {
    start_times[tid()] = gettimeofday_us()
}

probe syscall.read.return {
    start_time = start_times[tid()]
    if (start_time) {
        duration = gettimeofday_us() - start_time
        delete start_times[tid()]
        if ($return > 0) {
            process_io_bytes[execname(), "read"] += $return
            if ($return > 1048576) {
                large_reads[execname()]++
                printf("LARGE READ: %s read %d bytes (latency %d us)\n",
                       execname(), $return, duration)
            }
        }
        if (duration > 50000) {
            slow_syscalls["read"]++
            printf("SLOW READ SYSCALL: %s latency %d us\n", execname(), duration)
        }
    }
}

probe syscall.write.return {
    start_time = start_times[tid()]
    if (start_time) {
        duration = gettimeofday_us() - start_time
        delete start_times[tid()]
        if ($return > 0) {
            process_io_bytes[execname(), "write"] += $return
            if ($return > 1048576) {
                large_writes[execname()]++
                printf("LARGE WRITE: %s wrote %d bytes (latency %d us)\n",
                       execname(), $return, duration)
            }
        }
        if (duration > 50000) {
            slow_syscalls["write"]++
            printf("SLOW WRITE SYSCALL: %s latency %d us\n", execname(), duration)
        }
    }
}

probe timer.s(15) {
    printf("\n=== I/O Bottleneck Analysis ===\n")
    printf("Timestamp: %s\n", ctime(gettimeofday_s()))

    printf("\nSlow Syscalls (>50ms):\n")
    foreach (op in slow_syscalls) {
        printf("  %s: %d slow operations\n", op, slow_syscalls[op])
    }

    printf("\nLarge Read/Write Counts (>1MB):\n")
    foreach (proc in large_reads) {
        printf("  %s: %d large reads\n", proc, large_reads[proc])
    }
    foreach (proc in large_writes) {
        printf("  %s: %d large writes\n", proc, large_writes[proc])
    }

    printf("\nTotal Bytes by Process/Operation:\n")
    foreach ([proc, op] in process_io_bytes- limit 10) {
        printf("  %s %s: %d bytes\n", proc, op, process_io_bytes[proc, op])
    }

    delete slow_syscalls
    delete large_reads
    delete large_writes
    delete process_io_bytes
}

probe end {
    printf("\nI/O bottleneck detection completed\n")
}
EOF

chmod +x io_bottleneck_detector.stp
Run the detector while generating load:

sudo stap io_bottleneck_detector.stp &
STAP_PID=$!

sleep 5
./generate_io_load.sh
sleep 20

sudo kill $STAP_PID
Deliverable: A saved terminal capture (or sudo stap io_bottleneck_detector.stp > bottleneck_report.txt & output file) that includes at least one LARGE WRITE: line from the dd workers and one non-empty "Total Bytes by Process/Operation" entry for dd.

Expected result: Because each worker writes a 50 MB file with dd bs=1M count=50, you should see LARGE WRITE events attributed to dd, and the 15-second summary should show dd accumulating tens of megabytes under the write operation.

Step 3.3: Real-Time Performance Dashboard
Combine system call, CPU, and I/O signals into a single scrolling dashboard that refreshes on a fixed interval, giving a live, at-a-glance view suitable for troubleshooting during an incident.

cat > performance_dashboard.stp << 'EOF'
#!/usr/bin/env stap

global syscall_count, process_cpu_samples
global read_bytes, write_bytes
global total_syscalls, total_errors

probe syscall.* {
    if (target() == 0 || target() == pid()) {
        syscall_count[execname()]++
        total_syscalls++
    }
}

probe syscall.*.return {
    if (target() == 0 || target() == pid()) {
        if ($return < 0) {
            total_errors++
        }
    }
}

probe syscall.read.return {
    if (target() == 0 || target() == pid() && $return > 0) {
        read_bytes[execname()] += $return
    }
}

probe syscall.write.return {
    if (target() == 0 || target() == pid() && $return > 0) {
        write_bytes[execname()] += $return
    }
}

probe timer.profile {
    process_cpu_samples[execname()]++
}

function bar(value, scale) {
    width = value / scale
    if (width > 40) width = 40
    result = ""
    for (i = 0; i < width; i++) {
        result = result . "#"
    }
    return result
}

probe timer.s(5) {
    printf("\n========================================================\n")
    printf(" SYSTEMTAP REAL-TIME PERFORMANCE DASHBOARD\n")
    printf(" Time: %s\n", ctime(gettimeofday_s()))
    printf("========================================================\n")

    printf("\nTotal syscalls (5s window): %d   Errors: %d\n",
           total_syscalls, total_errors)

    printf("\n-- Top Processes by CPU Sample Count --\n")
    foreach (proc in process_cpu_samples- limit 8) {
        printf("  %-16s %5d  %s\n", proc, process_cpu_samples[proc],
               bar(process_cpu_samples[proc], 2))
    }

    printf("\n-- Top Processes by Syscall Count --\n")
    foreach (proc in syscall_count- limit 8) {
        printf("  %-16s %5d  %s\n", proc, syscall_count[proc],
               bar(syscall_count[proc], 5))
    }

    printf("\n-- Top Processes by Bytes Read --\n")
    foreach (proc in read_bytes- limit 5) {
        printf("  %-16s %10d bytes\n", proc, read_bytes[proc])
    }

    printf("\n-- Top Processes by Bytes Written --\n")
    foreach (proc in write_bytes- limit 5) {
        printf("  %-16s %10d bytes\n", proc, write_bytes[proc])
    }

    delete syscall_count
    delete process_cpu_samples
    delete read_bytes
    delete write_bytes
    total_syscalls = 0
    total_errors = 0
}

probe end {
    printf("\nDashboard stopped\n")
}
EOF

chmod +x performance_dashboard.stp
