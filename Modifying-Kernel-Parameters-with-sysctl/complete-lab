Task 2: Modifying Virtual Memory and Network Parameters
Subtask 2.1: Modifying Swappiness and Dirty Memory Parameters
Swappiness controls how aggressively the kernel swaps memory pages to disk (0-100). Dirty memory parameters control when dirty pages are flushed to disk.

# Check current values
echo "Current swappiness: $(sysctl -n vm.swappiness)"
echo "Current dirty_ratio: $(sysctl -n vm.dirty_ratio)"
echo "Current dirty_background_ratio: $(sysctl -n vm.dirty_background_ratio)"
echo "Current vfs_cache_pressure: $(sysctl -n vm.vfs_cache_pressure)"

# Create a memory monitoring script
cat > ~/monitor_memory.sh << 'EOF'
#!/bin/bash

echo "Memory Usage Monitoring"
echo "======================="
echo "Timestamp: $(date)"
echo "Swappiness: $(sysctl -n vm.swappiness)"
echo

free -h
echo

echo "Swap Usage:"
cat /proc/swaps
echo

echo "Memory Statistics:"
cat /proc/meminfo | grep -E "(Active|Inactive|Dirty|Writeback)"
EOF

chmod +x ~/monitor_memory.sh
./monitor_memory.sh

# Apply new VM tuning values
sudo sysctl vm.swappiness=10
sudo sysctl vm.dirty_ratio=15
sudo sysctl vm.dirty_background_ratio=5
sudo sysctl vm.dirty_expire_centisecs=3000
sudo sysctl vm.dirty_writeback_centisecs=500
sudo sysctl vm.vfs_cache_pressure=50

echo "Updated VM Parameters:"
sysctl vm.swappiness vm.dirty_ratio vm.dirty_background_ratio vm.vfs_cache_pressure
Deliverable: Run sysctl vm.swappiness vm.dirty_ratio vm.dirty_background_ratio vm.vfs_cache_pressure and confirm the output shows vm.swappiness = 10, vm.dirty_ratio = 15, vm.dirty_background_ratio = 5, and vm.vfs_cache_pressure = 50.

Subtask 2.2: Optimizing TCP and Buffer Parameters
# Enable TCP performance features
sudo sysctl net.ipv4.tcp_window_scaling=1
sudo sysctl net.ipv4.tcp_timestamps=1
sudo sysctl net.ipv4.tcp_sack=1
sudo sysctl net.ipv4.tcp_keepalive_time=600
sudo sysctl net.ipv4.tcp_keepalive_probes=3
sudo sysctl net.ipv4.tcp_keepalive_intvl=60

# Show available congestion control algorithms and select one
sysctl net.ipv4.tcp_available_congestion_control

if sysctl net.ipv4.tcp_available_congestion_control | grep -q bbr; then
    sudo sysctl net.ipv4.tcp_congestion_control=bbr
    echo "BBR congestion control enabled"
else
    sudo sysctl net.ipv4.tcp_congestion_control=cubic
    echo "CUBIC congestion control enabled"
fi

# Increase buffer sizes for high-performance networks
sudo sysctl net.core.rmem_default=262144
sudo sysctl net.core.rmem_max=16777216
sudo sysctl net.core.wmem_default=262144
sudo sysctl net.core.wmem_max=16777216
sudo sysctl net.ipv4.tcp_rmem="4096 65536 16777216"
sudo sysctl net.ipv4.tcp_wmem="4096 65536 16777216"

# Connection handling
sudo sysctl net.core.somaxconn=65535
sudo sysctl net.ipv4.tcp_max_syn_backlog=8192
sudo sysctl net.ipv4.tcp_syncookies=1
sudo sysctl net.ipv4.tcp_tw_reuse=1
sudo sysctl net.ipv4.tcp_fin_timeout=30

echo "Updated Network Parameters:"
sysctl net.core.rmem_max net.core.wmem_max net.core.somaxconn net.ipv4.tcp_congestion_control
Deliverable: Run sysctl net.core.rmem_max net.core.wmem_max net.core.somaxconn net.ipv4.tcp_congestion_control and confirm net.core.rmem_max = 16777216, net.core.wmem_max = 16777216, net.core.somaxconn = 65535, and a congestion control algorithm (bbr or cubic) is set.

